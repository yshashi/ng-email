{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Bundler resolution: @angular/compiler-cli's typings use extensionless
    // relative re-exports that NodeNext cannot follow. Our own imports keep
    // explicit .js extensions, so the emitted ESM still runs in Node as-is.
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts"]
}
