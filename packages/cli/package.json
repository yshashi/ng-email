{
  "name": "@ng-email/cli",
  "version": "0.0.0",
  "description": "ng-email command line: build Angular email components into a self-contained bundle that plain Node can import.",
  "license": "MIT",
  "type": "module",
  "keywords": ["angular", "email", "cli", "esbuild"],
  "bin": {
    "ng-email": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && chmod +x dist/bin.js && cp ../../LICENSE ."
  },
  "dependencies": {
    "@babel/core": "^8.0.1",
    "esbuild": "^0.28.2"
  },
  "peerDependencies": {
    "@angular/compiler-cli": "^22.0.0",
    "@ng-email/render": "*",
    "typescript": ">=6.0 <6.1"
  }
}
