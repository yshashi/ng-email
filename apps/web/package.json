{
  "name": "@ng-email/web",
  "version": "0.0.0",
  "private": true,
  "description": "The ng-email website: docs, block gallery and templates. Prerendered Angular app.",
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-registry.mjs && node scripts/sync-docs.mjs",
    "start": "npm run sync && ng serve",
    "build": "npm run sync && ng build",
    "build:pages": "npm run sync && ng build --base-href /ng-email/ && cp dist/browser/index.csr.html dist/browser/404.html"
  },
  "dependencies": {
    "@angular/common": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/platform-browser": "22.2.5",
    "@angular/platform-server": "22.2.5",
    "@angular/router": "22.2.5",
    "@angular/ssr": "22.2.6",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/inter-tight": "5.3.0",
    "@fontsource/dm-mono": "5.3.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler": "22.2.5",
    "@angular/compiler-cli": "22.2.5",
    "@tailwindcss/postcss": "4.3.5",
    "marked": "18.2.0",
    "postcss": "8.5.32",
    "prettier": "3.6.2",
    "shiki": "4.6.0",
    "tailwindcss": "4.3.5",
    "typescript": "~6.0.3"
  }
}
